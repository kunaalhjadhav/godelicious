# MVP default (SQLite, zero setup)
DATABASE_URL="file:./dev.db"

# Production (Postgres) example - uncomment and use instead:
# DATABASE_URL="postgresql://user:password@host:5432/godelicious?schema=public"

PORT=5000
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# Get test keys from your Razorpay dashboard: Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"

# "development" enables OTP codes being returned in the API response for
# testing without an SMS provider. Set to "production" once SMS is wired up.
NODE_ENV="development"

# Image/video uploads. Without these set, uploads fall back to local disk —
# fine for development, but files are LOST on every Railway/Render redeploy.
# Get these from your Cloudinary dashboard (free tier is enough to start):
# https://cloudinary.com/console — see PRODUCTION_READY_GUIDE.md section 1.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# TextLocal — real OTP SMS delivery. Without these set, OTP falls back to
# a dev-only mode that returns the code in the API response instead of texting it.
# Get TEXTLOCAL_API_KEY from control.textlocal.in > Settings > API Keys > Create Key.
# TEXTLOCAL_SENDER is your approved 6-character sender ID (e.g. GODELI) — also
# needs DLT registration in India before it can actually send.
TEXTLOCAL_API_KEY=""
TEXTLOCAL_SENDER=""
# Required by Indian DLT/TRAI regulations — your Principal Entity ID (PEID)
# from DLT registration. Without this, carriers may silently drop messages
# even when TextLocal itself reports success.
TEXTLOCAL_ENTITY_ID=""

# Firebase Cloud Messaging — real push notifications for order updates and
# chat replies. Without these set, push is disabled (chat/notifications
# still work via in-app polling, devices just won't get an alert when the
# app is closed). Get these from Firebase Console > Project Settings >
# Service Accounts > Generate new private key, which downloads a JSON file
# containing project_id, client_email, and private_key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# App Store / Google Play review login. Reviewers can't receive a real SMS, so
# give them this one test number and fixed code in the store's "review notes".
# Matches ONLY this number. Use a throwaway number and a 6-digit code of your
# choosing; leave both blank to disable.
REVIEW_PHONE=""
REVIEW_OTP=""

# ---- WhatsApp Business Cloud API (order alerts to admin / brand partners / venue owners) ----
# Optional. Without these, alerts still arrive as push notifications + the dashboard pop-up.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Approved template whose body is e.g.  "Godelicious alert: {{1}}"  (one variable)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Fallback alert number (digits, with country code) if not set in Admin > Settings
ADMIN_WHATSAPP=
