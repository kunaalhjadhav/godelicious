# MVP default (SQLite, zero setup)
DATABASE_URL="file:./dev.db"

# Production (Postgres) example - uncomment and use instead:
# DATABASE_URL="postgresql://user:password@host:5432/godelicious?schema=public"

PORT=5000
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# Get test keys from your Razorpay dashboard: Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"

# "development" enables OTP codes being returned in the API response for
# testing without an SMS provider. Set to "production" once SMS is wired up.
NODE_ENV="development"

# Image/video uploads. Without these set, uploads fall back to local disk —
# fine for development, but files are LOST on every Railway/Render redeploy.
# Get these from your Cloudinary dashboard (free tier is enough to start):
# https://cloudinary.com/console — see PRODUCTION_READY_GUIDE.md section 1.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
